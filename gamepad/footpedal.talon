
-

# Ikkegol Dual Left Pedal
key(f13):           user.footpedal_ikkegol_dual_left_down()
key(f13:up):        user.footpedal_ikkegol_dual_left_up()

# Ikkegol Dual Right Pedal
key(f14):           user.footpedal_ikkegol_dual_right_up()
key(f14:up):        user.footpedal_ikkegol_dual_right_up()

# Olympus RS31 Left Pedal
key(f15):           user.olympus_left_down()
key(f15:up):        user.olympus_left_up()

# Olympus RS31 Center Pedal
key(f16):           user.olympus_center_down()
key(f16:up):        user.olympus_center_up()

# Olympus RS31 Right Pedal
key(f17):           user.olympus_right_down()
key(f17:up):        user.olympus_right_up()

# Olympus RS31 Top Pedal
key(f18):           user.olympus_top_down()
key(f18:up):        user.olympus_top_up()
